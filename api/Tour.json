[{"@context": "http://schema.org/", "@type": "Way", "additionalType": "Tour", "identifier": "69627263-ea50-41ee-8cd1-a03d34d27013", "dateModified": "2025-09-29T15:04:17+02:00", "name": {"de": "_TEST Wanderweg"}, "disambiguatingDescription": {"de": "Kurzbeschreibung"}, "description": {"de": "<p>Beschreibung</p>"}, "license": "CC BY-SA", "image": [{"@type": "ImageObject", "contentUrl": "https://demopimtsoch.sos-ch-dk-2.exoscale-cdn.com/catalog/b/0/7/2/b072e06285529cd5fb378d90a80313d569411135_Designer_35_.jpeg"}], "additionalProperty": {"openstreetmap_id": "relation/5660984", "discoverSwissId": "tou_s9t_gjgchcgd-uqfa-ebuu-istb-qadtdetchabd"}}, {"@context": "http://schema.org/", "@type": "Tour", "additionalType": "Place", "identifier": "e8159768-c13a-4f8c-82ef-6664c605a35c", "dateModified": "2026-02-28T16:30:24+01:00", "name": {"de": "Witzweg"}, "disambiguatingDescription": {"de": "Kurzbeschreibung"}, "description": {"de": "<p>Schon immer waren die Appenzeller ein lustiges V&ouml;lkchen. Da erstaunt es nicht, dass der Appenzeller Witz auf der Liste der &laquo;lebendigen Traditionen der Schweiz&raquo; zu finden ist. Auf dem Witzweg von Heiden &uuml;ber Wolfhalden nach Walzenhausen bleibt demnach kein Auge trocken. Auf dem Weg verteilt erwarten Sie Audiostationen, wo sie Witze nicht nur lesen sondern auch h&ouml;ren k&ouml;nnen. Wer nicht alles zu Fuss gehen mag, kann eine Teilstrecke auch bequem mit dem Postauto zur&uuml;cklegen.</p>"}, "license": "CC0", "image": [{"@type": "ImageObject", "contentUrl": "https://demopimtsoch.sos-ch-dk-2.exoscale-cdn.com/catalog/7/2/6/f/726fd7028024d31b3ac494e80e87c8c9ee1fd684_Witzweg_Wanderung_0yrch0eekc26kr4.jpg"}], "openingHours": {"de": "Saison von M\u00e4rz bis Oktober"}, "additionalProperty": {"openstreetmap_id": "relation/14460829", "discoverSwissId": "tou_s9t_uibfjhgi-sbdq-evis-icuv-gggesgafqdfs"}}]